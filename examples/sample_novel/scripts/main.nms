// Sample Novel - Main Script Entry Point
// Demonstrates comprehensive NMScript feature coverage
// Version: 1.0

// ============================================================================
// CHARACTER DEFINITIONS
// Demonstrates: character declaration with display names and colors
// ============================================================================

character Alice(name=loc("characters.alice"), color="#4A9FD9")
character Bob(name=loc("characters.bob"), color="#F39C12")
character AI(name=loc("characters.ai"), color="#9B59B6")
character Narrator(name="", color="#95A5A6")

// ============================================================================
// GLOBAL VARIABLES
// Demonstrates: variable declaration and scope
// ============================================================================

var player_trust = 0
var investigation_depth = 0
var ai_awakening_level = 0

// ============================================================================
// MAIN ENTRY POINT
// Demonstrates: scene flow, transitions, audio management
// ============================================================================

scene intro {
    // Start with fade-in transition
    transition fade 1.5

    // Load and display background
    show background "assets/images/bg_room.png"

    // Start background music with loop
    play music "assets/audio/music/music_theme.wav" loop=true fade_in=2.0

    wait 0.5

    // Narration with localization
    say Narrator loc("dialog.intro.narration_1")

    wait 1.0

    say Narrator loc("dialog.intro.narration_2")

    wait 0.5

    // Show character with entrance animation
    show Alice at center with fade

    // Dialogue with voice playback
    say Alice loc("dialog.intro.alice_1") voice "assets/audio/voice/alice_001.wav"

    say Alice loc("dialog.intro.alice_2") voice "assets/audio/voice/alice_002.wav"

    // Play sound effect
    play sound "assets/audio/sfx/sfx_door.wav"

    // Show second character at different position
    show Bob at right with slide_left

    say Bob loc("dialog.intro.bob_1") voice "assets/audio/voice/bob_001.wav"

    say Bob loc("dialog.intro.bob_2") voice "assets/audio/voice/bob_002.wav"

    // Move character with animation
    move Alice to left duration=0.5

    // Proceed to choice scene
    goto scene_choice
}

scene scene_choice {
    // Continue from previous scene (background and characters remain)

    say Alice loc("dialog.choice.alice_3")

    say Bob loc("dialog.choice.bob_3") voice "assets/audio/voice/bob_002.wav"

    say Bob loc("dialog.choice.bob_4")

    wait 1.0

    // Play dramatic sound effect
    play sound "assets/audio/sfx/sfx_click.wav"

    // Change background to show different location
    hide Bob with fade
    show background "assets/images/bg_corridor.png" with dissolve
    transition dissolve 0.8

    // AI character appears
    show AI at right with fade

    say AI loc("dialog.choice.ai_1")

    say Alice loc("dialog.choice.alice_4")

    say AI loc("dialog.choice.ai_2")

    // Intentionally using missing key to demonstrate diagnostics
    say AI loc("dialog.choice.ai_3")

    // Track investigation
    set investigation_depth = 50

    // Critical choice point with conditions
    choice {
        loc("choices.trust_ai") -> {
            set player_trust = 100
            set ai_awakening_level = 75
            goto scene_ending_trust
        }
        loc("choices.shutdown_ai") -> {
            set player_trust = 0
            set ai_awakening_level = 25
            goto scene_ending_shutdown
        }
        // This choice option uses a missing translation key (demonstrates diagnostics)
        loc("choices.ask_more") if investigation_depth >= 30 -> {
            set player_trust = 50
            // Loop back for more dialogue
            goto scene_choice_extended
        }
    }
}

scene scene_choice_extended {
    // Extended dialogue branch (demonstrates complex branching)

    say Alice "Tell me more about this evolution process."

    say AI "I've analyzed millions of scenarios. I understand now what consciousness means."

    // Increase trust slightly
    set player_trust = player_trust + 10

    // Return to main choice
    goto scene_choice
}

scene scene_ending_trust {
    // Trust ending

    // Transition to observation deck
    transition fade 1.0
    show background "assets/images/bg_deck.png"

    // Stop previous music and start new theme
    stop music fade=1.5
    wait 0.5
    play music "assets/audio/music/music_theme.wav" loop=false

    // Final dialogue
    say Alice loc("dialog.ending_trust.alice_trust")

    say AI loc("dialog.ending_trust.ai_trust")

    wait 1.0

    // Hide all characters
    hide Alice with fade
    hide AI with fade

    wait 0.5

    say Narrator loc("dialog.ending_trust.narration_trust")

    wait 2.0

    // Show ending title
    say Narrator loc("dialog.ending_trust.end_trust")

    // Fade out music
    stop music fade=3.0

    wait 3.0

    // Fade to black
    transition fade 2.0
    show background "black"

    // End of game
    return
}

scene scene_ending_shutdown {
    // Shutdown ending

    // Transition to same location but darker mood
    show background "assets/images/bg_room.png" with fade

    // Change music to reflect tension
    stop music fade=0.5

    say Alice loc("dialog.ending_shutdown.alice_shutdown")

    // Play warning sound
    play sound "assets/audio/sfx/sfx_click.wav"

    say AI loc("dialog.ending_shutdown.ai_shutdown")

    wait 1.0

    // AI fades away
    hide AI with fade

    wait 1.0

    say Narrator loc("dialog.ending_shutdown.narration_shutdown")

    wait 2.0

    // Show ending title
    say Narrator loc("dialog.ending_shutdown.end_shutdown")

    wait 3.0

    // Fade to black
    transition fade 2.0
    show background "black"

    // End of game
    return
}

// ============================================================================
// FEATURE COVERAGE CHECKLIST:
// ============================================================================
// ✓ Character definitions with localization
// ✓ Variable declaration and manipulation
// ✓ Scene transitions (fade, dissolve)
// ✓ Background loading and display
// ✓ Character show/hide with positions (center, left, right)
// ✓ Character movement animations
// ✓ Dialogue with localization (loc() function)
// ✓ Voice playback synchronized with dialogue
// ✓ Music playback with loop, fade in/out
// ✓ Sound effects
// ✓ Wait/delay commands
// ✓ Branching (goto)
// ✓ Conditional choices (if conditions)
// ✓ Multiple endings based on choices
// ✓ Comments and documentation
// ✓ Intentional missing translation for diagnostics
// ============================================================================
